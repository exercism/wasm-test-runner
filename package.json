{
  "name": "@exercism/wasm-test-runner",
  "description": "Automated Test runner for exercism solutions in WebAssembly.",
  "author": "Derk-Jan Karrenbeld <derk-jan+github@karrenbeld.info>",
  "version": "3.1.1",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/exercism/wasm-test-runner"
  },
  "type": "module",
  "directories": {
    "lib": "./dist",
    "doc": "./docs",
    "test": "./test"
  },
  "bin": {
    "wasm-test-runner": "bin/run.sh"
  },
  "scripts": {
    "execute": "./bin/run.sh",
    "execute:dev": "pnpm build && pnpm execute",
    "prebuild": "rimraf ./dist",
    "build": "pnpm tsc --project ./src/tsconfig.json --outDir ./dist",
    "watch": "pnpm build -w",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm test:bare && pnpm lint",
    "lint": "pnpm eslint src test --ext ts,js,tsx,jsx,mjs -c eslint.config.mjs",
    "test": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js ./*",
    "test:bare": "node --experimental-vm-modules node_modules/jest/bin/jest.js --roots test --testPathIgnorePatterns=\"fixtures/\""
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@exercism/babel-preset-javascript": "^0.7.0",
    "@exercism/static-analysis": "^0.14.0",
    "@exercism/wasm-lib": "^0.2.0",
    "@jest/console": "^30.4.1",
    "@jest/globals": "^30.4.1",
    "@jest/reporters": "^30.4.1",
    "@jest/test-result": "^30.4.1",
    "@typescript-eslint/typescript-estree": "^8.62.1",
    "@typescript-eslint/visitor-keys": "^8.65.0",
    "babel-jest": "^30.4.1",
    "chalk": "^5.6.2",
    "jest": "^30.4.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@exercism/eslint-config-tooling": "^0.10.0",
    "@tsconfig/node16": "^16.1.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12"
  }
}
